{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@microchat/server": ["packages/server/src"],
      "@microchat/client": ["packages/client/src"],
      "@microchat/crypto": ["packages/crypto/src"],
      "@microchat/shared": ["packages/shared/src"]
    },
    "disableReferencedProjectLoad": true
  },
  "references": [
    { "path": "packages/shared" },
    { "path": "packages/crypto" },
    { "path": "packages/server" },
    { "path": "packages/client" }
  ],
  "include": ["packages/**/src/**/*.ts", "packages/**/src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "apps",
    "packages/**/dist",
    "packages/**/dist/**",
    "packages/server/src/test-worker.ts"
  ]
}
