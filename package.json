{
    "name": "@microchat/root",
    "private": true,
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "typecheck": "pnpm -r typecheck",
        "lint": "biome check .",
        "lint:fix": "biome check --fix .",
    "dev": "pnpm -r --parallel dev",
    "dev:local": "pnpm -r --parallel --filter @microchat/server --filter @microchat/web dev",
    "dev:web": "pnpm --filter @microchat/web dev",
        "ship": "./scripts/deploy.sh"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.2",
        "typescript": "^5.4.0"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    }
}
